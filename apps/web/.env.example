# Copie para apps/web/.env e ajuste. Este é o único arquivo de ambiente do
# monorepo: todos os pacotes o carregam via @educa-escola/env.

# Postgres local: `pnpm run db:start` sobe exatamente este banco.
DATABASE_URL=postgresql://postgres:password@localhost:5432/educa-escola

# Gere um valor próprio: `openssl rand -base64 32` (mínimo 32 caracteres).
BETTER_AUTH_SECRET=troque-por-um-segredo-de-no-minimo-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Opcional: sobrescreve o banco usado pelos testes de integração.
# Por padrão os testes usam DATABASE_URL com o sufixo `_test`.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/educa-escola_test
