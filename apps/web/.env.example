# Copie para apps/web/.env e ajuste. Este é o único arquivo de ambiente do
# monorepo: todos os pacotes o carregam via @educa-escola/env.

# Postgres local: `pnpm run db:start` sobe exatamente este banco.
DATABASE_URL=postgresql://postgres:password@localhost:5432/educa-escola

# Gere um valor próprio: `openssl rand -base64 32` (mínimo 32 caracteres).
BETTER_AUTH_SECRET=troque-por-um-segredo-de-no-minimo-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Cifragem da foto do aluno. 32 bytes em base64: `openssl rand -base64 32`.
# Sem ela o app sobe, mas cadastrar foto falha com instrução — nunca grava em claro.
MEDIA_ENCRYPTION_KEY=

# Onde o Órbita atende. Sem ela, a aba Apps mostra o catálogo mas abrir um app
# é recusado com instrução — melhor que mandar a pessoa para uma URL inventada.
# ORBITA_BASE_URL=https://orbita.exemplo.com

# Cifra a credencial do modelo do Astro. 32 bytes em base64. Para acrescentar
# ao seu .env sem colar na linha anterior (arquivo sem quebra no fim):
#   printf '\nASSISTANT_ENCRYPTION_KEY=%s\n' "$(openssl rand -base64 32)" >> apps/web/.env
# Sem ela o app sobe e a tela recusa gravar a credencial — nunca grava em claro.
# Chave própria, separada da de mídia: girar uma não obriga a recadastrar a outra.
ASSISTANT_ENCRYPTION_KEY=

# Armazenamento de arquivos. `memory` no local e no CI, `r2` em produção.
# Em produção `memory` é recusado: seria perda de dado silenciosa no deploy seguinte.
STORAGE_DRIVER=memory

# Credencial S3 do bucket do R2. Crie em R2 -> Manage API tokens.
# Obrigatórias apenas quando STORAGE_DRIVER=r2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=orbitaedu-prod
# Opcional: sobrescreve https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Presente, a suíte de storage roda contra o R2 de verdade; ausente, ela é
# pulada com aviso e o contrato roda contra o adaptador em memória.
# NUNCA aponte para o bucket de produção: a suíte apaga o que cria.
# R2_TEST_BUCKET=orbitaedu-test

# Opcional: sobrescreve o banco usado pelos testes de integração.
# Por padrão os testes usam DATABASE_URL com o sufixo `_test`.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/educa-escola_test
